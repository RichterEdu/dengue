  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FocoHUDInfo
  nome: "a brom\xE9lia"
  textoAoMirar: "Brom\xE9lia com \xE1gua acumulada nas folhas"
  dica: "Brom\xE9lia guarda \xE1gua entre as folhas. Regue o copinho com \xE1gua
    sanit\xE1ria dilu\xEDda (1 colher de sopa por litro) duas vezes por semana."
  textoAoEliminar: 
  textoFerramentaErrada: "N\xE3o precisa arrancar nem cobrir. Brom\xE9lia se trata
    com <b>\xE1gua sanit\xE1ria</b> dilu\xEDda."
  usarCorPropria: 0
  corDaBarra: {r: 0.25, g: 1, b: 0.8, a: 1}
  esconderProgresso: 0
